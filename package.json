{
  "name": "kube-inspector",
  "version": "1.0.0",
  "private": true,
  "description": "A Node.js TUI for inspecting and monitoring Kubernetes clusters in real-time — pods, deployments, services, nodes, and more, live in your terminal.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajaxecho3/kube-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/ajaxecho3/kube-inspector/issues"
  },
  "homepage": "https://github.com/ajaxecho3/kube-inspector#readme",
  "scripts": {
    "start": "node --no-deprecation --import tsx/esm src/index.tsx",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "kubernetes",
    "k8s",
    "tui",
    "cli",
    "terminal",
    "devops",
    "monitoring",
    "ink",
    "react"
  ],
  "author": "ajaxecho3",
  "license": "ISC",
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "ink": "^7.0.0",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^29.0.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
